# VISHWAS server configuration. Copy to server/.env for local runs, or enter
# these in Plesk → Node.js → Custom environment variables. Placeholders only —
# never commit real values.

# ── Required ─────────────────────────────────────────────────────────────
# Shared key the app sends as x-vishwas-key for the SMS/WhatsApp alert routes.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
VISHWAS_APP_KEY=

# PostgreSQL. Prefer a database on the same server (host 127.0.0.1/localhost);
# keep port 5432 closed to the internet. Without it, accounts/history/recordings
# API is off and only SMS/WhatsApp alerts work.
DATABASE_URL=postgresql://USERNAME:PASSWORD@127.0.0.1:5432/DATABASE_NAME
# Set to "require" only for a database on another host that needs TLS.
DATABASE_SSL=
DATABASE_POOL_MAX=10
# Apply migrations automatically at start (1/0). You can also run `npm run migrate`.
MIGRATE_ON_START=1

# Private folder for recordings — OUTSIDE httpdocs so the web server never serves it.
# Plesk example: /var/www/vhosts/adabhishek1.in/vishwas-data
STORAGE_DIR=
MAX_UPLOAD_MB=200
SESSION_DAYS=30

# Public HTTPS address of the API (used in password-reset links, Twilio callbacks
# and WhatsApp clip links).
PUBLIC_URL=https://adabhishek1.in/api
# 1 when nginx/Plesk proxies requests to this app (so rate limits see real client IPs).
TRUST_PROXY=1
PORT=8787

# ── Optional: password-reset emails ─────────────────────────────────────
# SMTP connection URL, e.g. smtps://USER:PASSWORD@mail.adabhishek1.in:465
SMTP_URL=
MAIL_FROM=VISHWAS <no-reply@adabhishek1.in>

# ── Optional: SMS / WhatsApp alerts (Twilio) ────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
DEFAULT_COUNTRY_CODE=91
