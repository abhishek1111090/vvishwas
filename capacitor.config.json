{
  "appId": "com.vishwas.safety",
  "appName": "VISHWAS",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DEFAULT"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_vishwas",
      "iconColor": "#5856D6"
    }
  }
}
