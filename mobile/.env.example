# Copy to .env.local (git-ignored) for development. Never commit real values.
#
# HTTPS base URL of the VISHWAS server API. When set, the app uses server
# accounts and backs up SOS events, location and recordings; when empty,
# everything stays on the phone (device-local accounts).
#   Production builds (eas.json "preview"/"production") use https://adabhishek1.in/api
#   For development, point it at a test server or an HTTPS tunnel.
EXPO_PUBLIC_VISHWAS_API_URL=

# Same value as VISHWAS_APP_KEY on the server. It ships inside the app, so it
# only gates the SMS/WhatsApp alert endpoints against casual misuse; it is not
# a secret. For EAS builds set it with:  eas env:create --name EXPO_PUBLIC_VISHWAS_API_KEY
EXPO_PUBLIC_VISHWAS_API_KEY=
