    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "eslint-config-expo": "~57.0.2",
    "expo": "~57.0.30",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-battery": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-contacts": "~57.0.8",
    "expo-crypto": "~57.0.4",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-sms": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "lucide-react-native": "^1.61.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "test": "jest"
  },
  "private": true,
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "eslint": "^9.39.5",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|lucide-react-native|@noble/.*|standard-navigation)"
    ],
    "resolver": "react-native-worklets/jest/resolver"
  }
